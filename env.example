# Copie para .env.local e preencha. Nada disso é obrigatório pra rodar o site.
NEXT_PUBLIC_SITE_URL=https://arestiatech.com.br
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_INSTAGRAM_URL=

# --- Formulário de contato (só no servidor — NUNCA com prefixo NEXT_PUBLIC_) ---
# Chave da API do Resend (resend.com). Sem ela o formulário responde 503 e mostra o fallback.
RESEND_API_KEY=
# Para onde chegam os contatos do site
CONTACT_TO_EMAIL=
# Remetente. Precisa ser um endereço de domínio verificado no Resend (ex.: ArestIA Site <site@arestiatech.com.br>).
# Sem domínio verificado o Resend só entrega pro e-mail dono da conta, usando onboarding@resend.dev.
CONTACT_FROM_EMAIL=
